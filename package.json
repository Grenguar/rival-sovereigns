{
  "name": "sovereign",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "tsx tools/gen-credits.ts --check",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pregen": "tsx tools/gen-curves.ts && tsx tools/gen-names.ts && tsx tools/make-placeholders.ts && tsx tools/build-atlas.ts",
    "pregen:sprites": "tsx tools/make-placeholders.ts",
    "pregen:atlas": "tsx tools/build-atlas.ts",
    "assets:fetch": "tsx tools/fetch-assets.ts",
    "credits": "tsx tools/gen-credits.ts",
    "credits:check": "tsx tools/gen-credits.ts --check",
    "test": "vitest run",
    "test:cross-engine": "playwright test",
    "test:watch": "vitest",
    "lint": "eslint . && tsc --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "pixi.js": "^8.6.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "sharp": "^0.35.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vitest": "^3.2.4"
  }
}
